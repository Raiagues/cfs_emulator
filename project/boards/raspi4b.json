{
  "board": "raspi4b",
  "name": "Raspberry Pi 4B",
  "os": [
    "raspios"
  ],
  "os_labels": {
    "raspios": "Raspberry Pi OS"
  },
  "targets": [
    "qemu",
    "physical"
  ],
  "buses": {
    "i2c-bus.1": {
      "device": "/dev/i2c-1",
      "dt_node": "/soc/i2c@7e804000",
      "label": "I²C 1",
      "sensor_pins": {"VCC": [1, 17], "GND": [6, 9, 14, 20, 25, 30, 34, 39], "SDA": [3], "SCL": [5]},
      "transport": "linux_i2c",
      "library": "linux_i2c_lib"
    }
  },
  "header_pins": [
    "3V3", "5V", "GPIO2 SDA", "5V", "GPIO3 SCL", "GND", "GPIO4", "GPIO14 TX",
    "GND", "GPIO15 RX", "GPIO17", "GPIO18", "GPIO27", "GND", "GPIO22", "GPIO23",
    "3V3", "GPIO24", "GPIO10 MOSI", "GND", "GPIO9 MISO", "GPIO25", "GPIO11 SCLK", "GPIO8 CE0",
    "GND", "GPIO7 CE1", "GPIO0 ID_SD", "GPIO1 ID_SC", "GPIO5", "GND", "GPIO6", "GPIO12",
    "GPIO13", "GND", "GPIO19", "GPIO16", "GPIO26", "GPIO20", "GND", "GPIO21"
  ],
  "os_families": {
    "raspios": "linux"
  },
  "build": {
    "raspios": {
      "architecture": "aarch64-linux-gnu",
      "cmake": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++",
        "CMAKE_FIND_ROOT_PATH": "/usr/aarch64-linux-gnu",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY",
        "CFE_SYSTEM_PSPNAME": "pc-linux",
        "OSAL_SYSTEM_OSTYPE": "posix"
      }
    }
  }
}
