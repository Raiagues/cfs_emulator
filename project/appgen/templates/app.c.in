/**
 * @file
 *   Application entry point and initialization for @PREFIX@.
 */

/*
** Include Files:
*/
#include "@APP@.h"
#include "@APP@_dispatch.h"
#include "@APP@_components.h"
#include "@APP@_eventids.h"
#include "@APP@_version.h"

#include <string.h>

/*
** Global data
*/
@PREFIX@_Data_t @PREFIX@_Data;

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * **/
/*                                                                            */
/* Application entry point and main process loop                              */
/*                                                                            */
/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * **/
void @PREFIX@_Main(void)
{
    CFE_Status_t     Status;
    CFE_SB_Buffer_t *SBBufPtr;

    CFE_ES_PerfLogEntry(@PREFIX@_PERF_ID);

    /* Perform application-specific initialization. */
    Status = @PREFIX@_Init();
    if (Status != CFE_SUCCESS)
    {
        @PREFIX@_Data.RunStatus = CFE_ES_RunStatus_APP_ERROR;
    }

    /*
    ** Application run loop
    */
    while (CFE_ES_RunLoop(&@PREFIX@_Data.RunStatus) == true)
    {
        CFE_ES_PerfLogExit(@PREFIX@_PERF_ID);

        /* Pend on receipt of command packet. */
        Status = CFE_SB_ReceiveBuffer(&SBBufPtr, @PREFIX@_Data.CommandPipe, CFE_SB_PEND_FOREVER);

        CFE_ES_PerfLogEntry(@PREFIX@_PERF_ID);

        if (Status == CFE_SUCCESS)
        {
            @PREFIX@_TaskPipe(SBBufPtr);
        }
        else
        {
            CFE_EVS_SendEvent(@PREFIX@_PIPE_ERR_EID, CFE_EVS_EventType_ERROR,
                             "@PREFIX@: SB Pipe Read Error, App Will Exit");
            @PREFIX@_Data.RunStatus = CFE_ES_RunStatus_APP_ERROR;
        }
    }

    CFE_ES_PerfLogExit(@PREFIX@_PERF_ID);
    CFE_ES_ExitApp(@PREFIX@_Data.RunStatus);
}

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * **/
/*                                                                            */
/* Application initialization                                                 */
/*                                                                            */
/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * **/
CFE_Status_t @PREFIX@_Init(void)
{
    CFE_Status_t Status;

    memset(&@PREFIX@_Data, 0, sizeof(@PREFIX@_Data));
    @PREFIX@_Data.RunStatus = CFE_ES_RunStatus_APP_RUN;

    /* Register the events and create the Software Bus command pipe. */
    Status = CFE_EVS_Register(NULL, 0, CFE_EVS_EventFilter_BINARY);
    if (Status == CFE_SUCCESS)
    {
        Status = CFE_MSG_Init(CFE_MSG_PTR(@PREFIX@_Data.HkTlm.TelemetryHeader),
                              CFE_SB_ValueToMsgId(@PREFIX@_HK_TLM_MID), sizeof(@PREFIX@_Data.HkTlm));
    }
    if (Status == CFE_SUCCESS)
    {
        Status = CFE_SB_CreatePipe(&@PREFIX@_Data.CommandPipe, @PREFIX@_PLATFORM_PIPE_DEPTH,
                                   @PREFIX@_PLATFORM_PIPE_NAME);
    }

    /* Subscribe to ground commands, housekeeping requests and scheduler wakeup. */
    if (Status == CFE_SUCCESS)
    {
        Status = CFE_SB_Subscribe(CFE_SB_ValueToMsgId(@PREFIX@_CMD_MID), @PREFIX@_Data.CommandPipe);
    }
    if (Status == CFE_SUCCESS)
    {
        Status = CFE_SB_Subscribe(CFE_SB_ValueToMsgId(@PREFIX@_SEND_HK_MID), @PREFIX@_Data.CommandPipe);
    }
    if (Status == CFE_SUCCESS)
    {
        Status = CFE_SB_Subscribe(CFE_SB_ValueToMsgId(@PREFIX@_WAKEUP_MID), @PREFIX@_Data.CommandPipe);
    }
    if (Status == CFE_SUCCESS)
    {
        Status = @PREFIX@_ComponentsInit();
    }

    if (Status == CFE_SUCCESS)
    {
        CFE_EVS_SendEvent(@PREFIX@_INIT_INF_EID, CFE_EVS_EventType_INFORMATION,
                         "@PREFIX@ Initialized. Version %s", @PREFIX@_VERSION);
    }
    else
    {
        CFE_ES_WriteToSysLog("@PREFIX@: Initialization failed, RC = 0x%08lX\n", (unsigned long)Status);
    }

    return Status;
}
