#!/usr/bin/env python3
"""Start Flight Studio, or use its shared tools without a web interface."""
import argparse
import json
import os
from pathlib import Path
import sys
import subprocess


ROOT = Path(__file__).resolve().parent
HELP = """Usage:
  ./start [--ui] [--port PORT]
  ./start --no-ui COMMAND [OPTIONS]

Web interface:
  ./start
  ./start --ui --port 8766

Command line:
  ./start --no-ui source install
  ./start --no-ui setup --target native --check
  ./start --no-ui build
  ./start --no-ui run
  ./start --no-ui stop
  ./start --no-ui status
  ./start --no-ui profile --board raspi4b --os raspios
  ./start --no-ui profile --native
  ./start --no-ui emulator --image flight-studio:local
  ./start --no-ui boot --target qemu
  ./start --no-ui simulate-preview --model tmp105
  ./start --no-ui app new attitude_app
  ./start --no-ui app delete attitude_app
  ./start --no-ui library new payload_lib
  ./start --no-ui library list
  ./start --no-ui library remove payload_lib
  ./start --no-ui run --target physical --host raspberrypi.local
  ./start --no-ui project --help
  ./start --no-ui signals --help
  ./start --no-ui simulate --help

Run './start --no-ui COMMAND --help' for command options.
"""


def replace(argv):
    os.execv(argv[0], argv)


def main(argv=None):
    from hardware.targets import selected_target
    from project.defaults import BOARD_PORT
    argv = list(sys.argv[1:] if argv is None else argv)
    os.chdir(ROOT)
    if argv and argv[0] in {'-h', '--help'}:
        print(HELP)
        return 0
    if not argv or argv[0] in ('--ui', '--port') or argv[0].startswith('--port='):
        options = argv[1:] if argv[:1] == ['--ui'] else argv
        replace([sys.executable, str(ROOT / 'interface/server.py'), *options])
        return 0
    if argv[0] != '--no-ui':
        print(HELP, file=sys.stderr)
        return 2
    argv = argv[1:]
    if argv[:1] == ['ground']:
        from ground_station.console import main as ground
        return ground(ROOT, argv[1:])
    if argv[:1] == ['signals']:
        replace([sys.executable, '-m', 'sensors.cli', *argv[1:]])
        return 0
    if argv and argv[0] in {'project', 'simulate'}:
        if any(arg == '--root' or arg.startswith('--root=') for arg in argv[1:]):
            print('Commands use the project containing ./start; --root is not supported.', file=sys.stderr)
            return 2
        if argv[0] == 'project':
            from project.manage import main as project_cli
            return project_cli(argv[1:], public=True)
        from sensors.simulator import main as simulate
        return simulate(argv[1:], public=True)

    parser = argparse.ArgumentParser(prog='./start --no-ui', description='Flight Studio command-line tools.')
    commands = parser.add_subparsers(dest='command')
    source = commands.add_parser('source', help='Manage the pinned official NASA checkout')
    source.add_argument('action', choices=('install', 'status'))
    source.add_argument('--json', action='store_true')
    status = commands.add_parser('status', help='Show workspace and target status')
    status.add_argument('--json', action='store_true')
    status.add_argument('--target', choices=('native', 'physical', 'qemu'))
    target = commands.add_parser('target', help='Show or select the target')
    target.add_argument('name', nargs='?', choices=('native', 'qemu', 'physical'))
    target.add_argument('--use-board', action='store_true')
    target.add_argument('--json', action='store_true')
    journey = commands.add_parser('journey', help='Show or reset first-flight observations')
    journey.add_argument('--target', choices=('native', 'qemu', 'physical'))
    journey.add_argument('--reset', action='store_true')
    journey.add_argument('--json', action='store_true')
    profile = commands.add_parser('profile', help='Show or select the native or board/OS profile')
    profile.add_argument('--json', action='store_true')
    selection = profile.add_mutually_exclusive_group()
    selection.add_argument('--native', action='store_true', help='Use this computer without a board')
    selection.add_argument('--board', help='Board identifier from the hardware catalog')
    profile.add_argument('--os', help='Operating system identifier for the selected board')
    emulator = commands.add_parser('emulator', help='Show or select the Docker image and local SSH port')
    emulator.add_argument('action', nargs='?', choices=('image', 'key', 'start', 'stop', 'logs', 'status'))
    emulator.add_argument('--json', action='store_true')
    emulator.add_argument('--image', help='Docker image tag or registry reference')
    emulator.add_argument('--port', type=int, help='Local port forwarded to the emulated board')
    apps = commands.add_parser('app', help='Create or select mission applications')
    apps.add_argument('action', choices=('list', 'new', 'edit', 'add', 'enable', 'disable', 'remove', 'delete', 'rename'),
                      help='remove excludes the app from the mission; delete also removes its sources')
    apps.add_argument('name', nargs='?')
    apps.add_argument('--to', metavar='NEW_NAME')
    apps.add_argument('--priority', type=int)
    apps.add_argument('--stack-size', type=int)
    apps.add_argument('--wakeup-hz', type=float)
    apps.add_argument('--hk-hz', type=float)
    apps.add_argument('--preview', action='store_true', help='Print the source/configuration plan without writing it')
    apps.add_argument('--json', action='store_true')
    libraries = commands.add_parser('library', help='Create and manage native mission libraries')
    libraries.add_argument('action', choices=('list', 'new', 'add', 'remove', 'delete', 'rename'),
                           help='remove excludes the library from the mission; delete also removes its sources')
    libraries.add_argument('name', nargs='?')
    libraries.add_argument('--to', metavar='NEW_NAME')
    libraries.add_argument('--preview', action='store_true')
    libraries.add_argument('--json', action='store_true')
    for action in ('first-boot', 'model-test', 'sensor-test', 'setup', 'build', 'boot', 'run', 'stop', 'shutdown', 'connect', 'probe', 'logs', 'values', 'simulate-preview'):
        command = commands.add_parser(action)
        command.add_argument('--json', action='store_true')
        command.add_argument('--target', choices=('native', 'qemu', 'physical'),
                             help='Defaults to the target selected in the interface or profile command')
        command.add_argument('--host', help='Physical board hostname, IP or SSH alias')
        command.add_argument('--user', help='SSH user; defaults to OpenSSH configuration')
        command.add_argument('--ssh-port', type=int, default=BOARD_PORT)
        command.add_argument('--identity-file', help='Local SSH private key path')
        command.add_argument('--directory', help="cFS installation folder relative to the board user's home")
        if action in {'build', 'run'}:
            command.add_argument('--sensorless', action='store_true', help='Physical build without sensor apps')
        if action == 'setup':
            command.add_argument('--jobs', type=int, help='Save the number of parallel native build jobs')
            command.add_argument('--check', action='store_true', help='Report prerequisites without installing packages')
        if action == 'boot':
            command.add_argument('--retry', action='store_true', help='Retry SSH on a running emulator')
        if action == 'run':
            follow = command.add_mutually_exclusive_group()
            follow.add_argument('--follow', action='store_true', help='Follow the console after cFS reaches OPERATIONAL')
            follow.add_argument('--no-follow', dest='follow', action='store_false')
            command.set_defaults(follow=False)
        if action == 'logs':
            command.add_argument('--kind', choices=('boot', 'flight'), default='flight')
        if action in {'sensor-test', 'model-test'}:
            command.add_argument('--device', required=True)
        if action == 'simulate-preview':
            command.add_argument('--scenario', help='Run a named register-level scenario for --device')
            source = command.add_mutually_exclusive_group()
            source.add_argument('--device', help='Configured sensor ID')
            source.add_argument('--model', help='Python sensor model; no board is needed')
    commands.add_parser('project', help='Project generator commands (project --help)')
    commands.add_parser('ground', help='Connect, send a command or listen to flight telemetry')
    commands.add_parser('signals', help='Inspect and configure sensor signals and orbit (signals --help)')
    commands.add_parser('simulate', help='Synthetic sensor data (simulate --help)')
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 0
    if args.command == 'target':
        from hardware.manager import HardwareManager
        try:
            if args.use_board and args.name != 'physical':
                parser.error('--use-board requires target physical')
            result = (HardwareManager(ROOT).select_target(args.name, board_visit=args.use_board)
                      if args.name else {'target': selected_target(ROOT)})
            print(json.dumps(result) if args.json else result['target'] or 'Choose an execution target')
            return 0
        except (OSError, RuntimeError, ValueError) as error:
            parser.exit(1, f'Error: {error}\n')
    if args.command == 'source':
        from project.nasa_source import install, source_status
        try:
            result = install(ROOT) if args.action == 'install' else source_status(ROOT)
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            parser.exit(1, f'Error: {error}\n')
        print(json.dumps(result) if args.json else f'NASA cFS {result["state"]} · {result["revision"] or result["url"]}')
        return int(result['state'] != 'ready')
    if args.command == 'journey':
        from journey import Store
        store = Store(ROOT)
        target = args.target or selected_target(ROOT)
        result = store.reset(target) if args.reset else store.snapshot(target)
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            for step, state in result['steps'].items():
                print(f"{step:8} {'done' if state['done'] else 'available' if state['reachable'] else 'locked'}")
        return 0
    if args.command == 'emulator':
        from hardware.infrastructure import emulator_config, save_emulator
        from hardware.manager import HardwareManager
        try:
            config = emulator_config(ROOT)
            if args.image is not None or args.port is not None:
                if args.image is not None:
                    config['image'] = args.image
                if args.port is not None:
                    config['ssh_port'] = args.port
                config = save_emulator(HardwareManager(ROOT), config)
            if args.action == 'image':
                from hardware.emulator_image import prepare
                result = prepare(ROOT)
                print(json.dumps(result) if args.json else result['image'])
            elif args.action == 'key':
                from hardware.emulator_ssh import prepare_identity
                result = prepare_identity(ROOT)
                print(json.dumps(result) if args.json else result['identity'])
            elif args.action == 'status':
                state = HardwareManager(ROOT).status()['qemu']
                print(json.dumps(state) if args.json else ('Emulator running' if state['running'] else 'Emulator stopped'))
            elif args.action:
                from jobs.cli import run
                options = {'target':'qemu'}
                if args.action == 'logs':
                    options['kind'] = 'boot'
                run(ROOT, {'start':'boot', 'stop':'shutdown', 'logs':'logs'}[args.action], options, args.json)
            else:
                print(json.dumps(config) if args.json else f'{config["image"]} · SSH {config["ssh_port"]}')
            return 0
        except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
            print(f'Error: {error}', file=sys.stderr)
            return 1
    if args.command == 'profile':
        if bool(args.board) != bool(args.os):
            parser.error('Select both --board and --os, or use --native')
        from project.workspace import Workspace
        workspace = Workspace(ROOT)
        try:
            from hardware.manager import HardwareManager
            manager = HardwareManager(ROOT)
            if args.native:
                result = manager.select_target('native')
            elif args.board:
                result = workspace.select_profile(args.board, args.os, hardware=manager)
                manager.select_target('qemu')
                result = {'target':'qemu', 'board': args.board, 'os': args.os, 'changed': result['changed']}
            else:
                config = workspace.model.load_config(ROOT)
                result = {'target': selected_target(ROOT), 'board': config['board'], 'os': config['os'], 'profiles': manager.profiles()}
            print(json.dumps(result) if args.json else (result['target'] or 'Choose an execution target'))
            return 0
        except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
            print(f'Error: {error}', file=sys.stderr)
            return 1
    if args.command in {'app', 'library'}:
        if (args.action == 'list' and args.name) or (args.action != 'list' and not args.name):
            parser.error(f'{args.command} list takes no name; all other actions require a name')
        if (args.action == 'rename') != bool(args.to):
            parser.error('Use rename NAME --to NEW_NAME')
        settings = {key: getattr(args, key) for key in ('priority', 'stack_size', 'wakeup_hz', 'hk_hz')
                    if getattr(args, key, None) is not None}
        if args.action not in {'new', 'edit'} and (settings or args.preview):
            parser.error('Configuration options apply to app new/edit or library new')
        from project.workspace import Workspace
        workspace = Workspace(ROOT)
        try:
            mission = workspace.mission.snapshot()
            if args.action in {'new', 'edit'}:
                mode = 'edit' if args.action == 'edit' else 'create'
                draft = workspace.mission_draft(args.command, args.name, settings,
                                                mission['source']['hash'], mode=mode)
                result = draft if args.preview else workspace.save_mission_draft(
                    args.command, args.name, draft['draft']['settings'], draft['expected_hash'],
                    draft['plan_hash'], mode=mode)
            elif args.action == 'rename':
                result = workspace.rename_module(args.command, args.name, args.to, mission['source']['hash'])
            elif args.action == 'list':
                result = mission if args.command == 'app' else mission['available_libraries']
            elif args.command == 'library':
                result = workspace.mission_library(args.action, args.name, mission['source']['hash'])
            elif args.action == 'delete':
                result = workspace.delete_app(args.name, mission['source']['hash'])
            else:
                result = workspace.mission_app(args.action, args.name, mission['source']['hash'])
            if args.json or args.preview:
                print(json.dumps(result, ensure_ascii=False))
            elif args.action == 'list':
                records = result if isinstance(result, list) else mission.get('available', [])
                for item in records:
                    print(item.get('name') if isinstance(item, dict) else item)
            else:
                print(f'{args.command} {args.action} · {args.name}')
            return 0
        except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
            print(f'Error: {error}', file=sys.stderr)
            return 1
    from hardware.manager import HardwareError, HardwareManager
    manager = HardwareManager(ROOT)
    target = getattr(args, 'target', None) or selected_target(ROOT)
    host, user = getattr(args, 'host', None), getattr(args, 'user', None)
    port = getattr(args, 'ssh_port', BOARD_PORT)
    identity, directory = getattr(args, 'identity_file', None), getattr(args, 'directory', None)
    sensorless = getattr(args, 'sensorless', False)
    if (host or user or port != BOARD_PORT or identity or directory) and target != 'physical':
        parser.error('SSH options require --target physical')
    if (user or port != BOARD_PORT or identity or directory) and not host:
        parser.error('SSH and installation options require --host')
    if sensorless and target != 'physical':
        parser.error('--sensorless requires --target physical')
    if args.command in {'connect', 'probe'} and target != 'physical':
        parser.error(args.command + ' requires --target physical')
    if args.command == 'values' and target != 'qemu':
        parser.error('values requires --target qemu')

    connection = {'host': host, 'user': user or '', 'port': port} if host else None
    if connection is not None:
        if identity:
            connection['identity_file'] = identity
        if directory:
            connection['directory'] = directory
    if args.command == 'setup' and (connection is not None or args.jobs is not None):
        from hardware.infrastructure import save
        if args.jobs is not None and target != 'native':
            parser.error('--jobs applies to native builds')
        settings = {'connection': connection} if connection is not None else {'build_jobs': args.jobs}
        save(manager, {'target': target, **settings})

    # Setup needs the real terminal for sudo; all other operations use the same
    # adapter, deployment checks and execution lock as the browser interface.
    if args.command == 'setup' and args.check:
        from hardware.infrastructure import check_progress
        if not target:
            parser.error('Choose an execution target or pass --target')
        for frame in check_progress(manager, target):
            if frame['status'] != 'complete':
                continue
            for row in frame['checks']:
                print(f'{row["label"]} · {row["status"]} · {row["detail"]}', file=sys.stderr)
            print(json.dumps(frame) if args.json else ('Checks passed' if frame['ready'] else 'Checks failed'))
            return int(not frame['ready'])
    if args.command == 'setup' and target == 'qemu':
        result = subprocess.run(['/bin/bash', str(ROOT / 'scripts/setup.sh')], stdout=sys.stderr)
        if result.returncode == 0:
            print(json.dumps({'target': target, 'ready': True}) if args.json else 'Emulator ready')
        return result.returncode
    try:
        if args.command == 'status':
            snapshot = manager.status()
            state = dict(snapshot[args.target], next_action=snapshot['launch'][args.target]) if args.target else snapshot
            if args.json:
                print(json.dumps(state))
            elif args.target == 'native':
                native = state.get('pids') or []
                observed = state.get('last_operational') or '—'
                print(f'Native · PID {", ".join(map(str, native)) or "stopped"} · last OPERATIONAL {observed}')
            else:
                active = snapshot['execution']['running_targets']
                running = args.target in active if args.target else bool(active)
                print('Running · ' + (args.target or ', '.join(active)) if running else 'cFS stopped')
            return 0
        from jobs.cli import run
        options = {'target': target}
        if connection is not None:
            options['connection'] = connection
        if sensorless:
            options['sensorless'] = True
        if getattr(args, 'retry', False):
            options['retry'] = True
        for key in ('kind', 'model', 'device', 'scenario'):
            if getattr(args, key, None) is not None:
                options[key] = getattr(args, key)
        run(ROOT, args.command, options, args.json)
        if args.command in {'stop', 'shutdown'}:
            from ground_station.console import exchange
            list(exchange(ROOT, {'action':'stop', 'target':target, 'if_active':True}))
        if args.command == 'run' and args.follow:
            run(ROOT, 'logs', {**options, 'kind':'flight'})
        return 0
    except (HardwareError, OSError, ValueError) as error:
        print(f'Error: {error}', file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        sys.stdout = open(os.devnull, 'w')
        raise SystemExit(0)
    except (ValueError, OSError, RuntimeError) as error:
        sys.exit(f'Error: {error}')
