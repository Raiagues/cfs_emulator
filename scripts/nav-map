#!/usr/bin/env python3
"""Build the control inventory from browser sources and the HTTP dispatch table."""
import argparse
import ast
from html.parser import HTMLParser
import json
import re
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
PACK = ROOT / 'docs/design-pack'
STATIC = ROOT / 'interface/static'


def endpoints():
    tree = ast.parse((ROOT / 'interface/server.py').read_text())
    routes = {}
    for fn in ast.walk(tree):
        if not isinstance(fn, ast.FunctionDef) or fn.name not in {'do_GET', 'do_POST'}:
            continue
        for node in ast.walk(fn):
            if isinstance(node, ast.Dict):
                for key, value in zip(node.keys, node.values):
                    if isinstance(key, ast.Constant) and str(key.value).startswith('/api/'):
                        routes['GET ' + key.value] = ast.unparse(value).removeprefix('lambda: ')
            if isinstance(node, ast.If) and isinstance(node.test, ast.Compare):
                paths = [n.value for n in node.test.comparators if isinstance(n, ast.Constant)]
                for path in paths:
                    if isinstance(path, str) and path.startswith('/api/'):
                        calls = [ast.unparse(n.func) for stmt in node.body for n in ast.walk(stmt) if isinstance(n, ast.Call)]
                        functions = [name for name in calls if name.startswith(('app.', 'self.stream', 'journey.', 'infrastructure.'))
                                     and name not in {'app.exclusive', 'app.shells.get'}]
                        for stmt in node.body:
                            for call in ast.walk(stmt):
                                if isinstance(call, ast.Call) and ast.unparse(call.func) == 'app.exclusive':
                                    functions.append(ast.unparse(call.args[0]))
                        routes['POST ' + path] = ', '.join(dict.fromkeys(functions or calls))
    return routes


class Controls(HTMLParser):
    def __init__(self):
        super().__init__()
        self.rows = []

    def handle_starttag(self, tag, attrs):
        attr = dict(attrs)
        if tag not in {'button', 'input', 'select', 'textarea', 'a', 'summary'} and attr.get('role') not in {
            'button', 'switch', 'slider', 'tab', 'option', 'separator'}:
            return
        keys = ['#' + attr['id']] if attr.get('id') else []
        keys += [k for k in attr if k.startswith('data-')]
        if attr.get('name'):
            keys.append('[name=' + attr['name'] + ']')
        label = attr.get('aria-label') or attr.get('title') or attr.get('name') or ' '.join(keys) or tag
        self.rows.append((tag, keys, label, attr.get('href') or '', self.getpos()[0]))


def js_report(arguments):
    result = subprocess.run(['node', str(ROOT / 'interface/tests/browser/navigation.mjs'), *arguments],
                            cwd=ROOT, check=True, stdout=subprocess.PIPE, text=True)
    return json.loads(result.stdout)


def cell(value):
    return str(value).replace('|', '\\|').replace('\n', ' ')


def row(*values):
    return '| ' + ' | '.join(map(cell, values)) + ' |'


def global_controls():
    flow = (PACK / '03_FIRST_RUN_FLOW.md').read_text().split('## Global controls map', 1)[1]
    return [[cell.strip() for cell in line.strip('|').split('|', 3)] for line in flow.splitlines()
            if line.startswith('| ') and not line.startswith(('| ---', '| Control |'))]


def generate(live=None):
    js = js_report([])
    server = endpoints()
    lines = ['# Flight Studio navigation map', '', 'Generated by `scripts/nav-map` from the current checkout.', '',
             '## Comparison with the first-run flow', '']
    lines += ['- ' + item for item in js['differences']]
    lines += ['', '## Controls and handlers', '',
              'Template parameters are shown as `{…}`. Endpoint lists include conditional calls within the handler.', '',
              row('Control', 'Source', 'Listener or delegated branch', 'Route or state', 'HTTP request', 'Server handler'), row(*['---'] * 6)]
    markup = js['markup'] + [[p.name, 1, p.read_text()] for p in sorted(STATIC.glob('*.html'))]
    rows = set()
    for name, start, fragment in markup:
        parser = Controls()
        parser.feed(fragment)
        for tag, keys, label, href, line in parser.rows:
            handlers = [h for h in js['handlers'] if set(h['keys']).intersection(keys)]
            where = f'`{name}:{start + line - 1}`'
            location = ', '.join(sorted({h['where'] for h in handlers})) or 'HTML / enclosing form or listener'
            destinations = {value for h in handlers for value in h['state']}
            requests = {value for h in handlers for value in h['api']}
            rows.add(row(label, where, location, href or ', '.join(sorted(destinations)) or tag,
                         ', '.join(sorted(requests)) or '—',
                         ', '.join(sorted({server.get(key, key) for key in requests})) or '—'))
    lines.extend(sorted(rows))
    lines += ['', '## Global controls in the flow specification', '',
              row('Control', 'Where', 'Action', 'Required destination', 'Registered API'), row(*['---'] * 5)]
    for control, where, action, destination in global_controls():
        required = re.findall(r'(?:GET|POST) /api/[\w/-]+', destination)
        registered = [server.get(key, 'MISSING ' + key) for key in required]
        lines.append(row(control, where, action, destination, ', '.join(registered) or 'Client'))
    lines += ['', '## Event bindings and keyboard shortcuts', '', row('Source', 'Selector or event', 'Route or state', 'HTTP request'),
              row(*['---'] * 4)]
    for handler in js['handlers']:
        lines.append(row(handler['where'], ', '.join(handler['keys']), ', '.join(handler['state']) or '—', ', '.join(handler['api']) or '—'))
    lines += ['', '## Server dispatch', '', row('HTTP request', 'Python handler'), row('---', '---')]
    lines.extend(row(name, '`' + value + '`') for name, value in sorted(server.items()))
    if live is not None:
        lines += ['', '## Browser observations', '', row('Entry route', 'Control', 'Destination or observed request'), row('---', '---', '---')]
        lines.extend(row(*entry) for entry in sorted(set(tuple(entry) for entry in live)))
    return '\n'.join(lines) + '\n'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--crawl', metavar='LOCAL_URL', help='also inspect rendered controls on a local test instance')
    parser.add_argument('--check', action='store_true', help='fail if the committed inventory is stale or mismatches remain')
    parser.add_argument('--verify-routes', action='store_true', help='exercise direct entry, a step link and browser history')
    args = parser.parse_args()
    flags = ['--verify-routes'] if args.verify_routes else []
    if args.crawl:
        observations = js_report([args.crawl, *flags])
    else:
        sys.path.insert(0, str(ROOT))
        from interface.tests.browser.lab import lab
        with lab(ROOT) as instance:
            observations = js_report([instance, *flags])
    if args.verify_routes:
        print('Direct routes, step navigation and browser history passed.')
        return
    result = generate(observations)
    output = PACK / 'NAVIGATION_MAP.md'
    if args.check:
        if not output.exists() or output.read_text() != result:
            raise SystemExit('Navigation map is stale')
        if result.partition('## Comparison')[2].partition('## Controls')[0].count('\n- '):
            raise SystemExit('First-run navigation differences remain')
    else:
        output.write_text(result)
        print(output.relative_to(ROOT))


if __name__ == '__main__':
    main()
